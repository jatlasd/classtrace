NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Comma-separated Clerk user IDs allowed to access the private operator console.
CLASSTRACE_OPERATOR_CLERK_USER_IDS=user_replace_me

# Server-only Resend configuration for Settings > Help and feedback.
# onboarding@resend.dev requires no custom domain, but it can send only to the
# email address associated with the Resend account.
RESEND_API_KEY=re_replace_me
CLASSTRACE_FEEDBACK_FROM_EMAIL=onboarding@resend.dev
CLASSTRACE_FEEDBACK_TO_EMAIL=your-resend-account-email@example.com

# Sentry's DSN is a public event-ingestion identifier. The auth token is a
# build-time secret used only to upload production source maps.
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_KEY@oORG_ID.ingest.us.sentry.io/PROJECT_ID
SENTRY_DSN=https://PUBLIC_KEY@oORG_ID.ingest.us.sentry.io/PROJECT_ID
SENTRY_AUTH_TOKEN=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/app
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/app

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# Optional destructive integration-test database. Never point this at DATABASE_URL.
TEST_DATABASE_URL=
TEST_DATABASE_RESET_ALLOWED=0
